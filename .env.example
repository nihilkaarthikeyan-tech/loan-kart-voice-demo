# ---------------------------------------------------------------------------
# LoanKart India - Kavya voice demo
# Copy this file to `.env` for local development. NEVER commit `.env`.
# All of these variables are SERVER-SIDE ONLY. None of them is prefixed with
# VITE_, so Vite never bundles them into the browser.
# ---------------------------------------------------------------------------

# Secret. Sarvam dashboard -> Settings -> API Keys.
SARVAM_API_KEY=your_sarvam_api_key_here

# IDs of the EXISTING Kavya agent. See README section "Where to get the IDs".
SARVAM_ORG_ID=your_org_id_here
SARVAM_WORKSPACE_ID=your_workspace_id_here
SARVAM_APP_ID=your_kavya_app_id_here

# Optional. Leave empty to use the latest COMMITTED version of the agent.
# Set a number (e.g. 3) only if you need to pin a specific committed version.
SARVAM_APP_VERSION=
